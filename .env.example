# ==========================================
# Aura Skincare Voice Agent - Environment Config
# ==========================================

# Groq API Key (Handles LLM Reasoning & Whisper STT on Free Tier)
# Free tier at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Production-ready free tier models: openai/gpt-oss-20b or llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b

# Sarvam AI API Key (Used ONLY for Human Indian Voice / TTS)
# Free tier at: https://platform.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shreya
SARVAM_LANGUAGE=en-IN

PORT=8000


